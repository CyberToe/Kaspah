# Neon or any Postgres connection string.
# Leave empty in development to use a local database in .data/
DATABASE_URL=

# Required in production. Use a long random string.
AUTH_SECRET=

# Public site URL, used in password-reset links.
APP_URL=http://localhost:3000

# Optional. If both are set, password-reset email is sent through Resend.
# With neither set, development shows the reset link on the page.
RESEND_API_KEY=
EMAIL_FROM=
